Bootstrap: docker
From: nvidia/cuda:12.4.1-cudnn9-devel-ubuntu22.04

%environment
  export PATH=/opt/conda/bin:$PATH
  export PYTHONPATH=/opt/satclip:$PYTHONPATH
  export CUDA_HOME=/usr/local/cuda
  export LD_LIBRARY_PATH=$CUDA_HOME/lib64:$LD_LIBRARY_PATH

%post
  # ── System packages ────────────────────────────────────────────────────────
  export DEBIAN_FRONTEND=noninteractive
  apt-get update && apt-get install -y --no-install-recommends \
    wget curl git build-essential cmake ninja-build \
    libglib2.0-0 libsm6 libxext6 libxrender-dev \
    libgl1-mesa-glx libgdal-dev gdal-bin \
    libgeos-dev libproj-dev \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

  # ── Miniconda (pinned for reproducibility) ─────────────────────────────────
  wget -q https://repo.anaconda.com/miniconda/Miniconda3-py310_24.1.2-0-Linux-x86_64.sh \
    -O /tmp/miniconda.sh
  bash /tmp/miniconda.sh -b -p /opt/conda
  rm /tmp/miniconda.sh
  export PATH=/opt/conda/bin:$PATH
  conda clean -afy

  # ── PyTorch (CUDA 12.4) ────────────────────────────────────────────────────
  # RoMa requires torch>=2.5.1 — this drives the version choice.
  # MATCHA requires >=2.3.0, JamMa's requirements.txt pin is not enforced by pip.
  conda install -y \
    pytorch==2.5.1 torchvision==0.20.1 pytorch-cuda=12.4 \
    -c pytorch -c nvidia
  conda clean -afy

  # ── Standard Python packages ───────────────────────────────────────────────
  pip install --no-cache-dir \
    numpy pandas pillow tqdm requests scipy matplotlib \
    h5py scikit-image opencv-python-headless \
    einops timm loguru yacs wandb albumentations \
    pycolmap poselib==2.0.4 ptflops PyYAML \
    accelerate tensorboard \
    open_clip_torch geoclip \
    lightning \
    torchgeo rasterio

  # ── kornia pinned (JamMa requires 0.7.0; LightGlue/LoFTR compatible) ───────
  pip install --no-cache-dir kornia==0.7.0

  # ── CUDA extensions (compile from source) ──────────────────────────────────
  # Compile for: Volta(7.0), Turing(7.5), Ampere(8.0/8.6), Ada(8.9), Hopper(9.0)
  export CUDA_HOME=/usr/local/cuda
  export PATH=$CUDA_HOME/bin:$PATH
  export TORCH_CUDA_ARCH_LIST="7.0;7.5;8.0;8.6;8.9;9.0"
  export MAX_JOBS=4

  pip install --no-cache-dir --no-build-isolation causal-conv1d==1.4.0
  pip install --no-cache-dir --no-build-isolation mamba-ssm==2.0.3

  # ── External repositories ──────────────────────────────────────────────────
  # DeDoDe first — lightweight, no conflicts
  pip install --no-cache-dir \
    "git+https://github.com/Parskatt/DeDoDe.git"

  # LightGlue — needs kornia>=0.6.11 (satisfied by 0.7.0)
  pip install --no-cache-dir \
    "git+https://github.com/cvg/LightGlue.git"

  # RoMa — pinned commit; needs torch>=2.5.1
  pip install --no-cache-dir \
    "git+https://github.com/Parskatt/RoMa.git@edd1b8b"

  # MATCHA — pulls diffusers==0.15.0 and huggingface-hub==0.23.4 as deps;
  # both are overridden immediately below.
  pip install --no-cache-dir \
    "git+https://github.com/nv-dvl/matcha.git"

  # Override MATCHA's older HuggingFace pins to the versions used in all pipelines.
  # matcha_pipeline.py monkey-patches the diffusers API difference at runtime.
  pip install --no-cache-dir --force-reinstall \
    diffusers==0.33.1 \
    huggingface-hub==0.30.2 \
    tokenizers==0.21.2 \
    transformers==4.49.0

  # JamMa — installed last; its requirements.txt pins (torch==2.0.1,
  # pytorch-lightning==1.3.5) are NOT enforced by pip-install-from-git.
  # The profiler incompatibility is avoided by passing profiler=None at model init.
  pip install --no-cache-dir \
    "git+https://github.com/leoluxxx/JamMa.git"

  # ── SatCLIP ────────────────────────────────────────────────────────────────
  # No pyproject.toml — clone and install editable so imports resolve.
  git clone --depth 1 https://github.com/microsoft/satclip.git /opt/satclip
  pip install --no-cache-dir -e /opt/satclip

  # ── Roma PyPI package (rotation library, MATCHA internal dep) ──────────────
  pip install --no-cache-dir roma==1.5.0

  # ── Final cleanup ──────────────────────────────────────────────────────────
  conda clean -afy
  pip cache purge

%runscript
  # Clone your repo on the cluster and bind-mount it at runtime — no rebuild needed:
  #   git clone https://github.com/YousefAyman005/UAV_Localization.git
  #   apptainer run --nv \
  #     --bind /path/to/UAV_Localization:/opt/uav_localization \
  #     --bind /path/to/UAV_Visloc:/data/UAV_Visloc \
  #     --bind /path/to/weights:/opt/uav_localization/weights \
  #     uav_localization.sif /opt/uav_localization/Baseline_pipeline.py --flights 03
  exec /opt/conda/bin/python "$@"
