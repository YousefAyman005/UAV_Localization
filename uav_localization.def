Bootstrap: docker
From: nvidia/cuda:12.4.1-cudnn-devel-ubuntu22.04

%environment
  export PATH=/opt/conda/bin:$PATH
  export PYTHONPATH=/opt/matcha:/opt/satclip:/opt/satclip/satclip:$PYTHONPATH
  export CUDA_HOME=/usr/local/cuda
  export LD_LIBRARY_PATH=$CUDA_HOME/lib64:$LD_LIBRARY_PATH

%post
  # ── System packages ────────────────────────────────────────────────────────
  export DEBIAN_FRONTEND=noninteractive
  apt-get update
  # Install wget/curl/certs first so subsequent steps can download files
  # even if later apt-get calls trigger a fork error in container post-install scripts.
  apt-get install -y --no-install-recommends \
    wget curl ca-certificates git
  # Remaining build deps; libgdal-dev/gdal-bin omitted — rasterio uses its own bundled GDAL.
  apt-get install -y --no-install-recommends \
    build-essential cmake ninja-build \
    libglib2.0-0 libsm6 libxext6 libxrender-dev \
    libgl1-mesa-glx \
    libgeos-dev libproj-dev \
    || true
  rm -rf /var/lib/apt/lists/*

  # ── Miniconda (pinned for reproducibility) ─────────────────────────────────
  wget -q https://repo.anaconda.com/miniconda/Miniconda3-py310_24.1.2-0-Linux-x86_64.sh \
    -O /tmp/miniconda.sh
  bash /tmp/miniconda.sh -b -p /opt/conda
  rm /tmp/miniconda.sh
  export PATH=/opt/conda/bin:$PATH
  conda clean -afy

  # ── PyTorch (CUDA 12.4) ────────────────────────────────────────────────────
  # RoMa requires torch>=2.5.1 — this drives the version choice.
  # MATCHA requires >=2.3.0, JamMa's requirements.txt pin is not enforced by pip.
  # Installed via pip (not conda) to avoid conda MKL conflicts with CUDA extensions.
  pip install --no-cache-dir \
    torch==2.5.1 torchvision==0.20.1 \
    --index-url https://download.pytorch.org/whl/cu124

  # ── Standard Python packages ───────────────────────────────────────────────
  pip install --no-cache-dir \
    numpy pandas pillow tqdm requests scipy matplotlib \
    h5py scikit-image opencv-python-headless \
    einops timm loguru yacs wandb albumentations \
    pycolmap poselib==2.0.4 ptflops PyYAML \
    accelerate tensorboard \
    open_clip_torch geoclip \
    lightning \
    torchgeo rasterio

  # ── kornia (>=0.7.3 satisfies torchgeo; LightGlue/LoFTR compatible) ──────────
  pip install --no-cache-dir "kornia>=0.7.3,<0.8"

  # ── External repositories ──────────────────────────────────────────────────
  # DeDoDe first — lightweight, no conflicts
  pip install --no-cache-dir \
    "git+https://github.com/Parskatt/DeDoDe.git"

  # LightGlue — needs kornia>=0.6.11 (satisfied by 0.7.0)
  pip install --no-cache-dir \
    "git+https://github.com/cvg/LightGlue.git"

  # RoMa — pinned commit; needs torch>=2.5.1
  pip install --no-cache-dir \
    "git+https://github.com/Parskatt/RoMa.git@edd1b8b"

  # MATCHA — pyproject.toml doesn't package the matcha/ source dir, so pip install
  # only installs metadata. Clone instead and expose via PYTHONPATH (%environment).
  git clone --depth 1 https://github.com/nv-dvl/matcha.git /opt/matcha
  # stabilityai/stable-diffusion-2-1 was deleted from HuggingFace. Redirect DIFT to
  # a local copy mounted at /data/sd21 (bind-mounted from DATAPOOL3 at runtime).
  sed -i 's|stabilityai/stable-diffusion-2-1|/data/sd21|g' /opt/matcha/third_party/dift/dift_sd.py

  # Override MATCHA's older HuggingFace pins to the versions used in all pipelines.
  # matcha_pipeline.py monkey-patches the diffusers API difference at runtime.
  pip install --no-cache-dir --force-reinstall \
    diffusers==0.33.1 \
    huggingface-hub==0.30.2 \
    tokenizers==0.21.2 \
    transformers==4.49.0

  # peft for the text-CLIP LoRA (clip_lora_train.py + clip_fusion_pipeline.py).
  # --no-deps: peft's deps (torch, transformers, accelerate, safetensors,
  # huggingface_hub, …) are already installed and pinned above; this avoids any
  # resolver churn that would unpin the HF stack.
  pip install --no-cache-dir --no-deps peft==0.13.2

  # ── SatCLIP ────────────────────────────────────────────────────────────────
  # No setup.py/pyproject.toml — clone and add to PYTHONPATH via %environment.
  git clone --depth 1 https://github.com/microsoft/satclip.git /opt/satclip

  # ── Efficient LoFTR ────────────────────────────────────────────────────────
  # Research repo (src/ layout), not pip-installable. Most inference deps (einops,
  # kornia, yacs, loguru, opencv, numpy) are already installed above; src/utils
  # additionally imports joblib, which is not — add it here. Cloned to
  # /opt/EfficientLoFTR; eloftr_pipeline.py adds it to sys.path at runtime — kept
  # OFF the global PYTHONPATH so its generic top-level `src` package can't shadow
  # anything else. Pretrained weights (eloftr_outdoor.ckpt) are bind-mounted at runtime.
  pip install --no-cache-dir joblib
  git clone --depth 1 https://github.com/zju3dv/EfficientLoFTR.git /opt/EfficientLoFTR

  # ── Roma PyPI package (rotation library, MATCHA internal dep) ──────────────
  pip install --no-cache-dir roma==1.5.0

  # ── Final cleanup ──────────────────────────────────────────────────────────
  conda clean -afy
  pip cache purge

%runscript
  # Clone your repo on the cluster and bind-mount it at runtime — no rebuild needed:
  #   git clone https://github.com/YousefAyman005/UAV_Localization.git
  #   apptainer run --nv \
  #     --bind /path/to/UAV_Localization:/opt/uav_localization \
  #     --bind /path/to/UAV_Visloc:/data/UAV_Visloc \
  #     --bind /path/to/weights:/opt/uav_localization/weights \
  #     uav_localization.sif /opt/uav_localization/Baseline_pipeline.py --flights 03
  exec /opt/conda/bin/python "$@"
